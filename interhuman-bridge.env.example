# /etc/interhuman-bridge.env — secrets for the interhuman-bridge container
# Copy this to /etc/interhuman-bridge.env on the bridge VM and fill in real
# values. DO NOT COMMIT the filled-in file.
#
# DEMO_STREAM_PROXY_TOKEN_SECRET must match the value set in the
# interhuman-recall-demo web app on Vercel.

DEMO_STREAM_PROXY_TOKEN_SECRET=change-me-at-least-16-chars

RECALL_API_KEY=
RECALL_REGION=eu-central-1

INTERHUMAN_API_KEY=

OPENAI_API_KEY=

API_PLATFORM_BASE_URL=https://api.interhuman.ai

# The public HTTPS URL of this VM (Caddy terminates TLS on :443 → :8787)
PUBLIC_BASE_URL=https://bridge.example.com

# The deployed report web app — reportUrl links will point here
WEB_APP_BASE_URL=https://your-web-app.vercel.app

# RTMP base URL Recall streams to. Same host as PUBLIC_BASE_URL, raw TCP :1935.
RTMP_PUBLIC_BASE=rtmp://bridge.example.com:1935

PORT=8787
RTMP_PORT=1935
BOT_NAME=Interhuman Signals
